{
  "name": "@warnyin/postgres-mcp",
  "version": "0.1.0",
  "description": "MCP server for managing PostgreSQL databases — query, execute, schema introspection, indexes, and EXPLAIN — runnable via npx.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "warnyin-postgres-mcp": "dist/index.js",
    "postgres-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "postgres",
    "postgresql",
    "pg",
    "database",
    "llm",
    "claude",
    "anthropic",
    "warnyin"
  ],
  "author": "warnyin",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warnyin/postgres-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/warnyin/postgres-mcp/issues"
  },
  "homepage": "https://github.com/warnyin/postgres-mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
